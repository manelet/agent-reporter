{
  "name": "agent-reporter",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:pb": "./pocketbase serve --http=127.0.0.1:8090",
    "dev:server": "pnpm --filter @agent-reporter/server dev",
    "dev:admin": "pnpm --filter @agent-reporter/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  }
}
