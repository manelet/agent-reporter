{
  "name": "reporter",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -k -n pb,apps \"pnpm dev:pb\" \"wait-on tcp:127.0.0.1:8090 && pnpm --parallel -r dev\"",
    "dev:pb": "pocketbase serve --http=127.0.0.1:8090",
    "dev:server": "pnpm --filter @reporter/server dev",
    "dev:admin": "pnpm --filter @reporter/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.6.3",
    "wait-on": "^9.0.10"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  }
}
