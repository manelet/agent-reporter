# 32-byte hex string (64 chars). Generate with: openssl rand -hex 32
AGENT_REPORTER_MASTER_KEY=

# PocketBase
PB_URL=http://127.0.0.1:8090
# Superuser credentials used by the server itself (scheduler, runner).
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Server. With portless, PORT is injected automatically — leave commented.
# PORT=3000
SERVER_HOST=127.0.0.1

# Admin's external origin (used for CORS on direct fetches).
ADMIN_ORIGIN=https://agent-reporter.localhost
